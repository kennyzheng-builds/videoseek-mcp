{
  "name": "videoseek-mcp",
  "version": "1.0.0",
  "description": "VideoSeek MCP — Find anything in any video. Semantic video search, video Q&A, persistent memory, and social media import for AI agents.",
  "type": "module",
  "bin": {
    "videoseek-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
