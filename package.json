    "semantic-search",
    "video-memory",
    "video-qa",
    "tiktok",
    "youtube",
    "llm",
    "claude"
  ],
  "author": "kennyzheng-builds",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kennyzheng-builds/videoseek-mcp"
  },
